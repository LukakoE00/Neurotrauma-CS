<?xml version="1.0" encoding="utf-8" ?>
<Override>
  <Afflictions>
    <!-- Tourniqueted (to have a Tourniquet applied). Visible in Health UI. Applied by the Tourniquet. Causes: Gangrene (if left on too long). -->
    <!-- Treatment Param prevents bot from removing it via default code. -->
    <Affliction
      name=""
      description=""
      identifier="tourniqueted"
      aliases="clampedarteries"

      healableinmedicalclinic="false"
      targets="human"
      limbspecific="true"
      iconcolors="127,127,127,255;127,127,127,255"
      TreatmentThreshold="999"

      showinhealthscannerthreshold="999"
      showiconthreshold="0"
      maxstrength="100">

      <Effect minstrength="0" maxstrength="100" strengthchange="0">
        <StatusEffect target="limb">
          <ReduceAffliction type="bleeding" strength="0.5"/>
          <ReduceAffliction identifier="arterialcutbleeding" amount="999" />
        </StatusEffect>
      </Effect>

      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="1,4" sheetelementsize="128,128" origin="0,0"/>
    </Affliction>

    <!-- Plaster Cast. Visible in Health UI. Counters negative effects and heals Fractures on extremities. -->
    <Affliction
      name=""
      description=""
      identifier="plastercast"
      
      healableinmedicalclinic="false"
      targets="human"
      limbspecific="true"
      type="resistance"
      isbuff="true"
      TreatmentThreshold="999"

      showinhealthscannerthreshold="999"
      showiconthreshold="0"
      maxstrength="100">

      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="2,4" sheetelementsize="128,128" origin="0,0"/>
    </Affliction>

    <!-- Arterial Bleeding -->
    <Affliction
      name=""
      description=""
      identifier="arterialcut"

      healableinmedicalclinic="true"
      basehealcost="210"
      targets="human"
      type="arterialcut"
      limbspecific="true"

      TreatmentSuggestionThreshold="1"
      TreatmentThreshold="999"

      showinhealthscannerthreshold="0"
      showiconthreshold="0"
      maxstrength="100">

      <Effect minstrength="0" maxstrength="100" strengthchange="1">
        <StatusEffect target="Limb">
          <Affliction identifier="arterialcutbleeding" strength="8" />
        </StatusEffect>

        <StatusEffect target="Character">
          <Conditional ishuman="False" />
          <ReduceAffliction identifier="arterialcut" amount="999"/>
        </StatusEffect>
      </Effect>

      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="3,3" sheetelementsize="128,128" origin="0,0"/>
    </Affliction>

    <!-- Arterial Bleeding Damage -->
    <Affliction
      name=""
      description=""
      identifier="arterialcutbleeding"
      targets="human"
      limbspecific="true"
      showinhealthscannerthreshold="999"
      showiconthreshold="999"
      maxstrength="1">

      <Effect minstrength="0.9" maxstrength="1" strengthchange="-5">
        <StatusEffect target="Character">
          <Conditional bloodloss="lte 99.5"/>
          <Affliction identifier="bloodloss" strength="1.5" />
        </StatusEffect>
        <StatusEffect target="Limb">
          <ParticleEmitter particle="bloodsplash" particlespersecond="50" scalemin="0.5" scalemax="0.45" velocitymin="0" velocitymax="40" anglemin="0" anglemax="360" />
          <ParticleEmitter particle="waterblood" particlespersecond="20" scalemin="0.5" scalemax="0.45" velocitymin="0" velocitymax="40" anglemin="0" anglemax="360" />
        </StatusEffect>
      </Effect>

      <Effect minstrength="0" maxstrength="0.9" strengthchange="-5" />

      <PeriodicEffect mininterval="6" maxinterval="6">
        <StatusEffect target="Limb">
          <Conditional inwater="false"/>
          <Explosion range="0.0" structuredamage="0" itemdamage="0" force="0.0" severlimbsprobability="0.0" decal="blood" decalsize="0.85" shockwave="false" underwaterbubble="false" />
        </StatusEffect>
      </PeriodicEffect>
    </Affliction>

    <!-- Gangrene / Cell death caused by cut off bloodflow. Visible in Health UI and Scanner. Causes: Sepsis. Requires Amputation above 15%. -->
    <Affliction
      name=""
      description=""
      identifier="gangrene"
      
      healableinmedicalclinic="false"
      targets="human"
      limbspecific="True"
      iconcolors="200,0,0,255;200,0,0,255;200,0,0,255"

      showinhealthscannerthreshold="0"
      showiconthreshold="15"
      maxstrength="100">

      <Effect minstrength="15" maxstrength="50" minvitalitydecrease="0" maxvitalitydecrease="15"/>
      
      <Effect minstrength="50" maxstrength="100" minvitalitydecrease="15" maxvitalitydecrease="25"/>

      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="6,3" sheetelementsize="128,128" origin="0,0"/>
    </Affliction>
  </Afflictions>
</Override>