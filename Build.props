<Project>
    <ItemGroup Condition="'$(BuildTarget)' != ''">
      <PackageReference Include="Barotrauma.ReferenceAssemblies.Vanilla.Publicized" Version="*-*" PrivateAssets="all" />
      <PackageReference Include="Barotrauma.ReferenceAssemblies.Libraries" Version="*-*" PrivateAssets="all" />

      <PackageReference Include="LuaCsForBarotraumaPlugin.$(BuildTarget)" Version="*-*" />
      <PackageReference Include="HarmonyX" Version="2.16.0" />
    </ItemGroup>
    
    <!-- User/Mod Settings -->
    <PropertyGroup>
        <!-- IMPORTANT: Should point to <Barotrauma_Install>\LocalMods\<Neurotrauma>\ -->
        <!-- IMPORTANT: ModDeplyDir Path must end with '\' -->
        <ModDeployDir>D:\SteamLibrary\steamapps\common\Barotrauma\LocalMods\Neurotrauma CS\</ModDeployDir>
        <!-- IMPORTANT: Avoid the use of special (IE: / : ; , \ < > ?) (periods "." are good) and non-english characters in the AssemblyName and RootNamespace.-->
        <!-- You must also change the assembly.dll name in ModConfig.xml to match the AssemblyName. -->
        <AssemblyName>Neurotrauma</AssemblyName>
        <RootNamespace>Neurotrauma</RootNamespace>
        <GenerateDocumentationFile>False</GenerateDocumentationFile>
        <!-- These two numbers should match under almost all circumstances. -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Authors />
    </PropertyGroup>

    <!-- You shouldn't change these unless you are having issues. -->
    <PropertyGroup>
        <PlatformTarget>x64</PlatformTarget>
        <Platforms>x64</Platforms>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
</Project>